    {
      "name": "3. Создать товар",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Статус 201', () => {",
              "  pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test('В ответе есть id и переданное имя', () => {",
              "  const body = pm.response.json();",
              "  pm.expect(body.id).to.be.a('number');",
              "  pm.expect(body.name).to.eql('Тест');",
              "});",
              "",
              "// Запоминаем id — его используют запросы 4, 5, 10, 11",
              "pm.collectionVariables.set('productId', pm.response.json().id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/products",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "products"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"name\": \"Тест\", \"price\": 100}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
