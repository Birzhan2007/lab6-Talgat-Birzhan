  "item": [
    {
      "name": "1. Health",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Статус 200', () => {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('База подключена', () => {",
              "  pm.expect(pm.response.json().db).to.eql('connected');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        }
      }
    },
